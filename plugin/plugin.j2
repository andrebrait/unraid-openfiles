<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="open.files3"
  author="{{ author }}"
  version="{{ env['PLUGIN_VERSION'] }}"
  launch="Tools/OpenFiles"
  pluginURL="https://raw.githubusercontent.com/andrebrait/unraid-openfiles/main/plugin/open.files3.plg"
  support="https://github.com/andrebrait/unraid-openfiles/issues"
  min="7.0.0"
  icon="folder-open"
>

<CHANGES>
<![CDATA[
{{ env['PLUGIN_CHANGELOG'] }}

For older releases, see https://github.com/andrebrait/unraid-openfiles/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/open.files3/unraid-openfiles-{{ env['PLUGIN_VERSION'] }}-noarch-1.txz">
<URL>https://github.com/andrebrait/unraid-openfiles/releases/download/{{ env['PLUGIN_VERSION'] }}/unraid-openfiles-{{ env['PLUGIN_VERSION'] }}-noarch-1.txz</URL>
<SHA256>{{ env['PLUGIN_CHECKSUM'] }}</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
# Replace the previous plugin of this name: keep its settings, then remove it.
OLD=/boot/config/plugins/open.files
NEW=/boot/config/plugins/open.files3
if [ -d "$OLD" ] && ! ls -A "$NEW" | grep -qv '\.txz$'; then
  find "$OLD" -mindepth 1 -maxdepth 1 ! -name '*.txz' -exec cp -a {} "$NEW"/ \;
fi
rm -f /boot/config/plugins/open.files.plg /var/log/plugins/open.files.plg
rm -rf "$OLD" /usr/local/emhttp/plugins/open.files

upgradepkg --install-new /boot/config/plugins/open.files3/unraid-openfiles-{{ env['PLUGIN_VERSION'] }}-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/open.files3/unraid-openfiles-*.txz 2>/dev/null | grep -v '{{ env['PLUGIN_VERSION'] }}')

echo "VERSION={{ env['PLUGIN_VERSION'] }}" > /usr/local/emhttp/plugins/open.files3/version.ini

echo ""
echo "----------------------------------------------------"
echo " open.files3 has been installed."
echo " Version: {{ env['PLUGIN_VERSION'] }}"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-openfiles

rm -rf /usr/local/emhttp/plugins/open.files3
rm -rf /boot/config/plugins/open.files3
]]>
</INLINE>
</FILE>

</PLUGIN>
