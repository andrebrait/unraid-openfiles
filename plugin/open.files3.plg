<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="open.files3"
  author="andrebrait"
  version="2026.11.11"
  launch="Tools/OpenFiles"
  pluginURL="https://raw.githubusercontent.com/andrebrait/unraid-openfiles/main/plugin/open.files3.plg"
  support="https://github.com/andrebrait/unraid-openfiles/issues"
  min="7.0.0"
  icon="folder-open"
>

<CHANGES>
<![CDATA[

### 2026.11.11

Open Files v3: a maintained fork by andrebrait of Derek Kaser's Open Files v2, itself based on Dan Landon's original Open Files.

- Installing it replaces the Open Files v2 plugin (open.files).
- Security: process names from lsof are escaped before display.
- Fix: killing a process requires the name shown in the list, checks it is still the same process (no PID reuse), refuses system processes, waits up to 10 seconds after SIGTERM before SIGKILL and reports the right signal.
- Support: https://github.com/andrebrait/unraid-openfiles/issues


For older releases, see https://github.com/andrebrait/unraid-openfiles/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/open.files3/unraid-openfiles-2026.11.11-noarch-1.txz">
<URL>https://github.com/andrebrait/unraid-openfiles/releases/download/2026.11.11/unraid-openfiles-2026.11.11-noarch-1.txz</URL>
<SHA256>d03a106be69e725a193519fb49a566c44ac74073721c0421ad9ade08b87d5cfa</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
# Replace the previous plugin of this name: keep its settings, then remove it.
OLD=/boot/config/plugins/open.files
NEW=/boot/config/plugins/open.files3
if [ -d "$OLD" ] && ! ls -A "$NEW" | grep -qv '\.txz$'; then
  find "$OLD" -mindepth 1 -maxdepth 1 ! -name '*.txz' -exec cp -a {} "$NEW"/ \;
fi
rm -f /boot/config/plugins/open.files.plg /var/log/plugins/open.files.plg
rm -rf "$OLD" /usr/local/emhttp/plugins/open.files

upgradepkg --install-new /boot/config/plugins/open.files3/unraid-openfiles-2026.11.11-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/open.files3/unraid-openfiles-*.txz 2>/dev/null | grep -v '2026.11.11')

echo "VERSION=2026.11.11" > /usr/local/emhttp/plugins/open.files3/version.ini

echo ""
echo "----------------------------------------------------"
echo " open.files3 has been installed."
echo " Version: 2026.11.11"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-openfiles

rm -rf /usr/local/emhttp/plugins/open.files3
rm -rf /boot/config/plugins/open.files3
]]>
</INLINE>
</FILE>

</PLUGIN>
