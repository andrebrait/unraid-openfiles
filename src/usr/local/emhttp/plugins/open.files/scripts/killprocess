const KILL_TERM = 15;
const KILL_KILL = 9;

function flush_all() {
	if (ob_get_contents() !== false) {
		ob_flush();
	}
	flush();
	usleep(500);  //* 5 hundreths of a second
}

//* Returns [state, ppid] from /proc/PID/stat, or null if the process is gone
function proc_stat($pid) {
	$stat = @file_get_contents("/proc/$pid/stat");
	if ($stat === false) {
		return null;
	}
	// comm may contain spaces and parentheses, so split after the last ")"
	$fields = explode(" ", substr($stat, strrpos($stat, ")") + 2));
	return [$fields[0], (int)$fields[1]];
}

function proc_comm($pid) {
	$comm = @file_get_contents("/proc/$pid/comm");
	return $comm === false ? null : rtrim($comm, "\n");
}

//* A zombie is already dead, it only waits to be reaped
function is_alive($pid) {
	$stat = proc_stat($pid);
	return $stat !== null && $stat[0] !== "Z";
}

function refuse($message) {
	echo "$message\n";
	echo "FAILED....\n";
	flush_all();
	exit(1);
}

$pnum  = $argv[1] ?? "";
$pname = $argv[2] ?? "";

if (!ctype_digit($pnum) || (int)$pnum <= 1) {
	refuse("Invalid process id.");
}
$pid = (int)$pnum;

//* Never kill ourselves, our ancestors (PHP/nginx/emhttpd serving this request) or the web server itself
$protected = [];
for ($p = getmypid(); $p > 1 && !in_array($p, $protected, true); $p = $stat[1] ?? 0) {
	$protected[] = $p;
	$stat        = proc_stat($p);
	if ($stat === null) {
		break;
	}
}
$comm = proc_comm($pid);
if (in_array($pid, $protected, true) || ($comm !== null && preg_match('/^(nginx|emhttpd|php-fpm.*)$/', $comm))) {
	refuse("Process $pid is part of the web interface and will not be killed.");
}

echo "Ending process $pid...\n";

if (!is_alive($pid)) {
	echo "Process $pid has ended...\n";
	echo "Success...\n";
	flush_all();
	exit(0);
}

//* The UI may be stale: make sure the PID still belongs to the process the user saw.
//* lsof truncates names, so accept a prefix match in either direction.
if ($pname !== "" && ($comm === null || !(str_starts_with($comm, $pname) || str_starts_with($pname, $comm)))) {
	refuse("Process $pid is now '" . ($comm ?? "?") . "', not '$pname'. Refusing to kill it.");
}

flush_all();

//***************************************
//* Kill softly (SIGTERM, up to 10 seconds)
//***************************************
posix_kill($pid, KILL_TERM);
for ($i = 0; $i < 20 && is_alive($pid); $i++) {
	if ($i === 0) {
		echo "Checking...\n";
		flush_all();
	}
	usleep(500000);
}

if (!is_alive($pid)) {
	echo "Process $pid killed with SIGTERM...\n";
} elseif (proc_comm($pid) !== $comm) {
	// PID was recycled while waiting
	echo "Process $pid has ended...\n";
} else {
	//***************************************
	//* Kill hard
	//***************************************
	echo "Process $pid could not be gently killed... will use SIGKILL...\n";
	posix_kill($pid, KILL_KILL);
	usleep(500000);
}

if (is_alive($pid) && proc_comm($pid) === $comm) {
	echo "FAILED....\n";
	flush_all();
	exit(1);
}
echo "Success...\n";

flush_all();
?>